# Настройки базы данных
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shop
# Для production используйте sslmode=require или verify-full
DB_SSLMODE=disable

# Настройки сервера
SERVER_PORT=8080

# CORS разрешённые origins (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:3000